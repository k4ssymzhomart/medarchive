# Render-образ бэкенда MedServicePrice.
# Отличие от backend/Dockerfile: контекст сборки = КОРЕНЬ репозитория, чтобы
# запечь в образ справочник и реальный архив прайсов. На Render нет volume-
# монтирования из репозитория (в compose они монтировались), поэтому файлы,
# нужные для seed-reference и ingest, кладём прямо в образ.

FROM python:3.12-slim

# Системные зависимости: Tesseract (rus) для битых сканов, poppler для рендера
# PDF, LibreOffice для конвертации .xls.
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    tesseract-ocr-rus \
    tesseract-ocr-eng \
    poppler-utils \
    libreoffice-calc \
    libgl1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ /app/
# Справочник услуг (для seed-reference) и реальный архив 10 прайсов (для ingest).
COPY ["Справочник услуг.xlsx", "/app/Справочник услуг.xlsx"]
COPY docs/ /app/docs/

EXPOSE 8000

# Старт через скрипт в образе: миграции + сид справочника + uvicorn.
# Цепочку команд держим в start.sh, а НЕ в render.yaml dockerCommand — Render
# ненадёжно парсит цепочки через && (вся строка уходит в одну команду -> 127).
# Скрипт запускается родным Docker CMD, поэтому парсинг Render не участвует.
RUN chmod +x /app/start.sh
CMD ["sh", "/app/start.sh"]
