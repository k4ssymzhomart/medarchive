# MedServicePrice окружение. Скопируйте в .env и заполните секреты.
# Секреты НЕ коммитим (см. .gitignore).

# --- Хост-порты (фиксированные, выделены под medarchive, чтобы не пересекаться
#     с типовыми 8000/5432/6379 других проектов). Контейнерные порты не меняются.
#     Нужен именно 8000? Поставьте APP_PORT=8000 здесь, без правок кода. ---
APP_PORT=8088
DB_PORT=5544
REDIS_PORT=6399
FRONTEND_PORT=5577

# --- Postgres ---
POSTGRES_USER=medpartners
POSTGRES_PASSWORD=medpartners
POSTGRES_DB=medpartners
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://medpartners:medpartners@postgres:5432/medpartners

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Object storage (S3 совместимое). Пусто => локальный том. ---
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=/data/storage
S3_ENDPOINT_URL=
S3_BUCKET=medpartners
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# --- AI провайдеры (опционально). Пусто => фолбэк на офлайн RapidFuzz. ---
# Эмбеддинги (кандидатогенератор)
EMBEDDINGS_PROVIDER=openai
OPENAI_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-large
EMBEDDINGS_DIM=3072

# Реранкер
RERANK_PROVIDER=cohere
COHERE_API_KEY=
RERANK_MODEL=rerank-v3.5

# LLM арбитр
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-4-8

# --- Пороги нормализации (раздел 8.3) ---
MATCH_HIGH_THRESHOLD=0.85
MATCH_LOW_THRESHOLD=0.60
RAPIDFUZZ_AUTO_THRESHOLD=0.92

# --- OCR ---
OCR_LANGUAGES=rus+eng
OCR_DPI=300

# --- Аутентификация оператора (раздел 4.2) ---
# Токен на админские эндпоинты (загрузка, сопоставление, очереди). Пусто =>
# админка ОТКРЫТА (удобно для dev/CI). В проде задайте длинный случайный токен;
# тот же токен пропишите во VITE_OPERATOR_TOKEN фронтенда.
OPERATOR_TOKEN=

# --- Прочее ---
ANOMALY_PCT_THRESHOLD=0.50
API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
FX_USD_KZT=475.0
LOG_LEVEL=INFO
